## Server environment variables
PORT=8085
NODE_ENV=development

## PostgreSQL connection (supports JDBC format like Recipen OR standard DATABASE_URL)
POSTGRES_URI=jdbc:postgresql://localhost:5432/pineapple_notes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

## Alternative standard PostgreSQL URL (if preferred over POSTGRES_URI)
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/pineapple_notes

## Auth (generate strong random strings in production)
ACCESS_TOKEN_SECRET=change-me-access-secret-32chars-min
REFRESH_TOKEN_SECRET=change-me-refresh-secret-32chars-min

## CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

## Debug flags (optional)
DEBUG_DB=0
DEBUG_AUTH=0
